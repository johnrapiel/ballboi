# Copy to .env and fill in the Clerk keys. Everything else works as-is locally.

# Database (matches docker-compose.yml)
DATABASE_URL=postgres://ballboi:ballboi@localhost:5432/ballboi

# Clerk: use a Development instance from dashboard.clerk.com > API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Native Google sign-in on Welcome. Leave empty and the Google button hides;
# Apple and email still work. From Google Cloud Console (see the setup guide).
# Formats:
#   web and iOS client IDs: 1234-abcd.apps.googleusercontent.com
#   iOS URL scheme: com.googleusercontent.apps.1234-abcd (the iOS client ID, reversed)
# The URL scheme goes into the iPhone build, so also add it to EAS
# (expo.dev > project > Environment variables, "development") before you build.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=

# API URL the Expo app calls. `pnpm dev:mobile` fills in this Mac's network
# address automatically; set it only to override, e.g. http://192.168.1.20:8080
# EXPO_PUBLIC_API_URL=

# The email that gets admin access in the app
ADMIN_EMAIL=you@example.com

# Ports
API_PORT=8080

# Object storage for Ball Boi video (S3-compatible). These match the SeaweedFS
# container in docker-compose.yml. For Cloudflare R2 use
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto;
# for AWS S3 leave S3_ENDPOINT empty and set S3_REGION.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=ballboi
S3_ACCESS_KEY_ID=ballboi
S3_SECRET_ACCESS_KEY=ballboi-local-secret

# Ball Boi ML server (optional locally; start it with `pnpm dev:ml`)
ML_SERVICE_URL=http://localhost:8000
ML_SECRET=local-dev-secret

# Web push (optional locally). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Messaging. "memory" needs no keys: messages last until the API restarts,
# and sample players reply to you in development.
MESSAGING_PROVIDER=memory
# For Stream Chat set MESSAGING_PROVIDER=stream and add the keys from
# dashboard.getstream.io > your app > Overview. Never commit them.
# STREAM_API_KEY=
# STREAM_API_SECRET=
# Optional: one blocked term per line, checked in first messages to non-connections.
# Keep this file outside the repo.
# MESSAGING_BLOCKED_TERMS_FILE=

# Claude moderation agent: reviews reports nobody has acted on for 6 hours.
# Off unless a key is set. Key from console.anthropic.com > API Keys.
# ANTHROPIC_API_KEY=
# MODERATION_AGENT_MODEL=claude-sonnet-5-5

# Beta Footage Release (spec decisions 85 and 92). Off locally and for the App
# Store launch. Turn it on for the private beta backend only. Bump the version
# whenever the release at ballboi.tennis/beta-release changes: everyone agrees
# again before their next recording. While it's on, beta footage is kept until
# launch.
BETA_RELEASE_REQUIRED=false
BETA_RELEASE_VERSION=1

# Emails to support@ballboi.tennis ("Something not working?" reports and the
# test-set list when a beta tester withdraws). Off until a key is set; reports
# are still saved in the database. Resend's free tier covers this (3,000
# emails a month). The from-address domain must be verified in Resend.
# RESEND_API_KEY=
# SUPPORT_EMAIL_TO=support@ballboi.tennis
# SUPPORT_EMAIL_FROM=Ball Boi <support@ballboi.tennis>

# Apple key (.p8) for Live Activity pushes and DeviceCheck device bans. Off
# until set; everything else works without it. Make one key at
# developer.apple.com > Account > Certificates, Identifiers & Profiles > Keys,
# with "Apple Push Notifications service (APNs)" and "DeviceCheck" ticked.
# APPLE_KEY_ID is the key's ID, APPLE_TEAM_ID is under Membership details.
# APPLE_PRIVATE_KEY is the whole .p8 file; on one line, put \n between lines.
# Never commit it. Production and staging keep it in Cloudflare secrets.
# APPLE_KEY_ID=
# APPLE_TEAM_ID=
# APPLE_PRIVATE_KEY=
