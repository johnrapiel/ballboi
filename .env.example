# Copy to .env and fill in the Clerk keys. Everything else works as-is locally.

# Database (matches docker-compose.yml)
DATABASE_URL=postgres://ballboi:ballboi@localhost:5432/ballboi

# Clerk: use a Development instance from dashboard.clerk.com > API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# API URL the Expo app calls. `pnpm dev:mobile` fills in this Mac's network
# address automatically; set it only to override, e.g. http://192.168.1.20:8080
# EXPO_PUBLIC_API_URL=

# The email that gets admin access in the app
ADMIN_EMAIL=you@example.com

# Ports
API_PORT=8080

# Object storage for Ball Boi video (S3-compatible). These match the SeaweedFS
# container in docker-compose.yml. For Cloudflare R2 use
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto;
# for AWS S3 leave S3_ENDPOINT empty and set S3_REGION.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=ballboi
S3_ACCESS_KEY_ID=ballboi
S3_SECRET_ACCESS_KEY=ballboi-local-secret

# Ball Boi ML server (optional locally; start it with `pnpm dev:ml`)
ML_SERVICE_URL=http://localhost:8000
ML_SECRET=local-dev-secret

# Web push (optional locally). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Messaging. "memory" needs no keys: messages last until the API restarts,
# and sample players reply to you in development.
MESSAGING_PROVIDER=memory
# Optional: one blocked term per line, checked in first messages to non-connections.
# Keep this file outside the repo.
# MESSAGING_BLOCKED_TERMS_FILE=
