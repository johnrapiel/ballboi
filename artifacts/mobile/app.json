{
  "expo": {
    "name": "Ball Boi",
    "slug": "ballboi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/roundel.png",
    "scheme": "ballboi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/roundel.png",
      "resizeMode": "contain",
      "backgroundColor": "#E2CEB0"
    },
    "ios": {
      "bundleIdentifier": "tennis.ballboi",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/roundel.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/roundel.png",
          "color": "#0A2447",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
